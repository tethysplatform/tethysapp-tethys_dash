+  if (!Number.isFinite(gridUnits)) return gridUnits;
+  const start = (colOrRowSize + marginPx) * gridPos + paddingPx;
+  const end = start + colOrRowSize * gridUnits + Math.max(0, gridUnits - 1) * marginPx;
+  return Math.round(end) - Math.round(start);
+}
