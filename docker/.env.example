# Copy to docker/.env and edit. docker/.env is git-ignored.

# REQUIRED: portal secret key. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
TETHYS_SECRET_KEY=change-me-to-a-long-random-string

# Chat model (must exist on ollama.com; pulled on first `up`).
TETHYSDASH_CHAT_LOCAL_MODEL=ornith:9b

# Dev server (serves static locally, no CDN) when true; production ASGI when false.
TETHYS_DEBUG=true

# Portal admin created during provisioning.
PORTAL_SUPERUSER_NAME=admin
PORTAL_SUPERUSER_PASSWORD=pass
PORTAL_SUPERUSER_EMAIL=admin@example.com

# Comma-separated hosts allowed to reach the portal (add your host/domain).
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1

# Host port the web app is published on. Change it if something else (e.g. a
# local `tethys manage start`) already occupies 8000.
TETHYSDASH_HOST_PORT=8000
